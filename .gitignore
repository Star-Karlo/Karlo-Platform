node_modules
/build
/.svelte-kit
/package
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Secrets. .env now holds COMMS_API_KEY, which is a live credential for the
# communication service — .env.example carries the names, never the values.
.env
.env.*
!.env.example

# Terraform. State lives in S3; the tfvars hold real hostnames and keys.
terraform/.terraform/
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/.terraform.lock.hcl
