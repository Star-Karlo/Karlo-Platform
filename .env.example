# Frontend configuration.
#
# Leave PUBLIC_API_URL unset for local development: requests then go to the
# relative path /api/v1, which the Vite dev proxy in vite.config.ts forwards to
# whichever service owns that path on localhost.
#
# Set it to point at a deployed environment, where the load balancer does the
# same path routing:
#   PUBLIC_API_URL=https://api.karlo.co.id/api/v1
PUBLIC_API_URL=

# Communication service (Customer Help / WhatsApp tickets).
#
# COMMS_API_KEY is a PRIVATE variable on purpose: it is a shared key that is not
# scoped to a user or a company, so it is held by this app's server routes and
# never reaches a bundle. A row in the service's `apikeys` collection with
# `isActive: true` is what makes a key valid.
COMMS_SERVICE_URL=http://localhost:4000
COMMS_API_KEY=

# MAPID basemap. PUBLIC_ because the browser fetches the tiles, so this key is
# visible in devtools by nature — ask MAPID to restrict it to your domains.
# Distinct from the business service's MAPID_KEY, which is for routing.
PUBLIC_MAPID_BASEMAP_KEY=
FMS_API_URL=https://fms-api.karlo.id
